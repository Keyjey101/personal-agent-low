{
  "name": "dispatcher",
  "version": "1.0.0",
  "private": true,
  "description": "Диспетчер — персональный операционный помощник: Telegram + GLM + SQLite",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "web": "node scripts/serve-web.mjs",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "gen-secrets": "tsx scripts/gen-secrets.ts"
  },
  "engines": {
    "node": ">=23.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.3",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.2.1",
    "grammy": "^1.35.0",
    "openai": "^5.8.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
