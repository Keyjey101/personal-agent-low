# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# твой chat_id (узнать у @userinfobot); сообщения от остальных игнорируются
TELEGRAM_ALLOWED_CHAT_ID=123456789

# === GLM ===
GLM_API_KEY=your-glm-api-key
# международный endpoint z.ai или китайский open.bigmodel.cn
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# актуальная модель с tool calling
GLM_MODEL=glm-4.7
# суточный лимит токенов, 0 = без лимита
GLM_DAILY_TOKEN_LIMIT=0

# === Web ===
# argon2id-хеш пароля: npm run gen-secrets
WEB_PASSWORD_HASH=$argon2id$...
# 32+ случайных байта base64: npm run gen-secrets
SESSION_SECRET=change-me
DOMAIN=dispatcher.example.com

# === Системное ===
TZ=Europe/Moscow
DATA_DIR=/data
PORT=8080
LOG_LEVEL=info
