# ============================================================
# Диспетчер: настройки. Скопируй в .env и заполни.
# Порты фиксированы в docker-compose: хост-порты 3000 и 3001
# (под текущий конфиг nginx) ведут в контейнер. Здесь порта нет.
# ============================================================

# ---------- Telegram ----------
# Токен бота: создай бота у @BotFather, он выдаст токен вида 1234567:AA...
TELEGRAM_BOT_TOKEN=
# Твой личный chat_id: напиши @userinfobot, он ответит числом.
# Бот будет отвечать ТОЛЬКО тебе, остальных игнорирует.
TELEGRAM_ALLOWED_CHAT_ID=

# ---------- GLM ----------
# API-ключ с платформы z.ai (или open.bigmodel.cn).
# Важно: подписка на чат — НЕ то же самое, что API-ключ.
GLM_API_KEY=
# Международный endpoint z.ai; для bigmodel.cn замени на
# https://open.bigmodel.cn/api/paas/v4
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Актуальная модель с tool calling (проверь в доках платформы)
GLM_MODEL=glm-4.7
# Суточный лимит токенов для экономии, 0 = без лимита
GLM_DAILY_TOKEN_LIMIT=0

# ---------- Веб-интерфейс ----------
# Это НЕ пароль, а его хеш. Придумай себе пароль для входа на сайт,
# запусти gen-secrets (см. README), введи пароль — скрипт напечатает
# две строки. Вставь их сюда КАК ЕСТЬ, вместе с одинарными кавычками:
# кавычки обязательны, потому что в хеше есть символы $, которые
# docker compose иначе подставляет как переменные.
WEB_PASSWORD_HASH=
# Случайная строка для подписи cookie (печатается тем же gen-secrets).
# Это не пароль, просто шум; менять после первого запуска не нужно.
SESSION_SECRET=

# ---------- Системное ----------
TZ=Europe/Moscow
DATA_DIR=/data
LOG_LEVEL=info
